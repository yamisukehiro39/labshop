{
  "openapi": "3.0.3",
  "info": {
    "title": "LabShop API",
    "version": "1.0.0",
    "description": "Educational lab only; secure and vulnerable modes. Prices in MAD cents."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Database readiness",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          }
        }
      }
    },
    "/config": {
      "get": {
        "summary": "Lab mode and version",
        "operationId": "get_config",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Search visible products (intentional SQLi in vulnerable mode)",
        "operationId": "get_products",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Create session",
        "operationId": "post_auth_login",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-LabShop-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "web"
              ]
            }
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke session",
        "operationId": "post_auth_logout",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-LabShop-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "web"
              ]
            }
          }
        ]
      }
    },
    "/me": {
      "get": {
        "summary": "Current user",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/orders": {
      "get": {
        "summary": "Current user orders",
        "operationId": "get_orders",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "summary": "Create order using server prices",
        "operationId": "post_orders",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewOrder"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-LabShop-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "web"
              ]
            }
          }
        ]
      }
    },
    "/orders/{id}": {
      "get": {
        "summary": "Order details (intentional IDOR in vulnerable mode)",
        "operationId": "get_orders_by_id",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/products/{id}/reviews": {
      "get": {
        "summary": "Read reviews",
        "operationId": "get_products_by_id_reviews",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "summary": "Create review (intentional stored XSS in vulnerable frontend)",
        "operationId": "post_products_by_id_reviews",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "500": {
            "description": "Internal error; request_id returned"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Review"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "X-LabShop-Client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "web"
              ]
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "labshop_session"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer"
          },
          "stock": {
            "type": "integer"
          },
          "icon": {
            "type": "string"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "NewOrder": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "product_id",
                "quantity"
              ],
              "properties": {
                "product_id": {
                  "type": "integer"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            }
          }
        }
      },
      "Review": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
